+let isSessionCipherYieldPatched = false;
+
+// Observability: counter of yielded decrypt attempts per rolling minute.
+// Logs a warn line whenever the rate crosses 100/min — early signal that
+// session staleness is degrading again even with the patch active. Pre-fix
+// production observed ~300/min from 'timed out waiting for message'; healthy
+// after patch should stay sub-50/min for blackCredPix-class instances.
+let yieldCount = 0;
+let yieldWindowStartMs = Date.now();
+const YIELD_RATE_THRESHOLD_PER_MIN = 100;
+
+function recordYield() {
+    yieldCount++;
+    const now = Date.now();
+    const elapsed = now - yieldWindowStartMs;
+    if (elapsed < 60_000) return;
+    const ratePerMin = (yieldCount * 60_000) / elapsed;
+    if (ratePerMin > YIELD_RATE_THRESHOLD_PER_MIN) {
+        // Plain console.warn — Evolution pino logger captures stderr globally.
+        // Stays single-line to keep JSON parsers happy.
+        // eslint-disable-next-line no-console
+        console.warn(`[libsignal-patch] HIGH yield rate detected — ${ratePerMin.toFixed(0)}/min over ${elapsed}ms window. Possible stale-session accumulation; consider reset or QR re-pair.`);
+    }
+    yieldCount = 0;
+    yieldWindowStartMs = now;
+}
+
+/**
+ * Workaround for libsignal-node event-loop starvation when decrypting with
+ * many stale sessions (upstream PR https://github.com/WhiskeySockets/Baileys/pull/2523,
+ * GH issue #2520). Yields to the event loop with `setImmediate` before each
+ * CPU-heavy `doDecryptWhisperMessage` attempt so keepalive pings + I/O can
+ * progress; otherwise event loop blocks 10-52s → 408 disconnect storm.
+ * Idempotent — guarded by module-level flag.
+ */
+function patchSessionCipherWithYield() {
+    if (isSessionCipherYieldPatched) return;
+    const proto = libsignal.SessionCipher && libsignal.SessionCipher.prototype;
+    if (!proto || typeof proto.doDecryptWhisperMessage !== 'function') return;
+    const original = proto.doDecryptWhisperMessage;
+    proto.doDecryptWhisperMessage = async function patchedDoDecryptWhisperMessage(...args) {
+        await new Promise(resolve => setImmediate(resolve));
+        recordYield();
+        return original.apply(this, args);
+    };
+    isSessionCipherYieldPatched = true;
+}
