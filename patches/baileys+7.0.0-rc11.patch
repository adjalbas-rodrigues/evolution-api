+/**
+ * Workaround for libsignal-node event-loop starvation when decrypting with
+ * many stale sessions (upstream PR https://github.com/WhiskeySockets/Baileys/pull/2523,
+ * GH issue #2520). Yields to the event loop with `setImmediate` before each
+ * CPU-heavy `doDecryptWhisperMessage` attempt so keepalive pings + I/O can
+ * progress; otherwise event loop blocks 10-52s → 408 disconnect storm.
+ * Idempotent — guarded by module-level flag.
+ */
+function patchSessionCipherWithYield() {
+    if (isSessionCipherYieldPatched) return;
+    const proto = libsignal.SessionCipher && libsignal.SessionCipher.prototype;
+    if (!proto || typeof proto.doDecryptWhisperMessage !== 'function') return;
+    const original = proto.doDecryptWhisperMessage;
+    proto.doDecryptWhisperMessage = async function patchedDoDecryptWhisperMessage(...args) {
+        await new Promise(resolve => setImmediate(resolve));
+        recordYield();
+        return original.apply(this, args);
+    };
+    isSessionCipherYieldPatched = true;
+}
