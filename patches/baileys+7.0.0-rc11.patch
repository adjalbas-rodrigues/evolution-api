+let isSessionCipherYieldPatched = false;
+
+// Observability: counter of yielded decrypt attempts per rolling minute.
+// Logs a warn line whenever the rate crosses 100/min — early signal that
+// session staleness is degrading again even with the patch active. Pre-fix
+// production observed ~300/min from 'timed out waiting for message'; healthy
+// after patch should stay sub-50/min for blackCredPix-class instances.
+let yieldCount = 0;
+let yieldWindowStartMs = Date.now();
+const YIELD_RATE_THRESHOLD_PER_MIN = 100;
+
+function recordYield() {
+    yieldCount++;
+    const now = Date.now();
+    const elapsed = now - yieldWindowStartMs;
+    if (elapsed < 60_000) return;
+    const ratePerMin = (yieldCount * 60_000) / elapsed;
+    if (ratePerMin > YIELD_RATE_THRESHOLD_PER_MIN) {
+        // Plain console.warn — Evolution pino logger captures stderr globally.
+        // Stays single-line to keep JSON parsers happy.
+        // eslint-disable-next-line no-console
+        console.warn(`[libsignal-patch] HIGH yield rate detected — ${ratePerMin.toFixed(0)}/min over ${elapsed}ms window. Possible stale-session accumulation; consider reset or QR re-pair.`);
+    }
+    yieldCount = 0;
+    yieldWindowStartMs = now;
+}
